gssps:Berriasian
    a gssp:GSSP ;
    gts:representsBoundary gtsd:BaseCretaceous ;
    gssp:correlationEvents "Candidates include: (1) Magnetic - base of Chron M18r, (2) Base of Calpionellid zone B, (3) ammonite FAD of Berriasella jacobi" ;
    schema:status "Proposed" ;
.

gssps:Burdigalian
    a gssp:GSSP ;
    gts:representsBoundary gtsd:BaseBurdigalian ;
    gssp:correlationEvents "Near planktonic foraminifer FAD of Globigerinoides altiaperturus or near top of magnetic polarity chronozone C6An" ;
    schema:location "Potentially in astronomicallytuned ODP core" ;
    schema:status "Proposed" ;
.

gssps:Calabrian
    a gssp:GSSP ;
    gts:representsBoundary gtsd:BaseCalabrian ;
    geo:hasGeometry
        [
            a geo:Geometry ;
            geo:asWKT "POINT (17.1348 39.0385)"^^geo:wktLiteral ;
        ] ;
    gssp:boundaryLevel "base of the marine claystone overlying the sapropelic marker Bed 'e' (Mediterranean Precession Related Sapropel, MPRS 176)" ;
