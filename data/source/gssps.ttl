            geo:asWKT "POINT (8.8364 44.6589)"^^geo:wktLiteral ;
        ] ;
    gssp:boundaryLevel "35m from the top of the section" ;
    gssp:correlationEvents "Magnetic - base of Chron C6Cn.2n; planktonic foraminifer FAD of Paragloborotalia kugleri; calcareous nannofossil near LAD Reticulofenestra bisecta (base Zone NN1); Oxygen isotopic event Mi-1." ;
    schema:citation <https://doi.org/10.18814/epiiugs/1997/v20i1/005> ;
    schema:location "Lemme-Carrosio Section, Allessandria Province, Italy" ;
    schema:status "Ratified 1996" ;
.

